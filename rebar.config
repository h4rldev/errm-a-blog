{erl_opts, [debug_info]}.
{deps, [
  {errm_sqlite, {git, "https://github.com/h4rldev/errm-SQLite", {branch, "main"}}},
  {errm_http, {git, "https://github.com/h4rldev/errm-HTTP", {branch, "main"}}},
  {errm_env, {git, "https://github.com/h4rldev/errm-ENV", {branch, "main"}}},
  {errm_uuid, {git, "https://github.com/h4rldev/errm-UUID", {branch, "main"}}},
  {errm_jwt, {git, "https://github.com/h4rldev/errm-JWT", {branch, "main"}}},
  {errm_json, {git, "https://github.com/h4rldev/errm-JSON", {branch, "main"}}},
  {errm_argon, {git, "https://github.com/h4rldev/errm-ARGON", {branch, "main"}}}
]}.

{profiles, [
    {migrations, [
      {src_dirs, ["migrator"]},
      {escript_name, "migrator"},
      {escript_main_app, migrator},
      {escript_incl_apps, [errm_sqlite]},
      {escript_incl_priv, [{errm_sqlite, "*.so"}]},
      {escript_emu_args, "%%! +sbtu +A1\n"}
    ]},
    {blogtest, [
      {src_dirs, ["blog_test", "src"]},
      {escript_name, "blog_test"},
      {escript_main_app, errm_a_blog},
      {escript_incl_priv, [{errm_sqlite, "*.so"}, {errm_http, "*.so"}, {errm_argon, "*.so"}]},
      {escript_incl_apps, [errm_sqlite, errm_http, errm_env, errm_uuid, errm_jwt, errm_json, errm_argon]},
      {escript_emu_args, "%%! -escript main blog_test\n"}
    ]}
]}.
